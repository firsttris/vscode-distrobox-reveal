{
  "name": "distrobox-reveal-in-explorer",
  "displayName": "Distrobox Reveal in File Explorer",
  "description": "Reveals the current file or folder in the host's file explorer when running inside Distrobox.",
  "version": "0.0.5",
  "publisher": "firsttris",
  "author": "Tristan Teufel",
  "repository": {
    "type": "git",
    "url": "https://github.com/firsttris/vscode-distrobox-reveal.git"
  },
  "icon": "folder.png",
  "packageManager": "bun@1.4.4",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "distrobox-reveal.reveal",
        "title": "Reveal in Host Explorer",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "distrobox-reveal.reveal",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "distrobox-reveal.reveal",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "distrobox-reveal.reveal",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "bun run compile && bunx vsce package --no-dependencies",
    "release:patch": "bun pm version patch",
    "release:minor": "bun pm version minor",
    "release:major": "bun pm version major",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/node": "26.x",
    "typescript": "^7.0.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.0.0"
  }
}
